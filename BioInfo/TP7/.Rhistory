#Exo 4
naif_fasta = function(taille){
nom = sprintf("Naif_%d.fasta", taille)
fileout = file(nom, open = "w")
nucleotides = c('A', 'T', 'C', 'G')
for (numero in 0:29) {
sequence = sample(nucleotides, size = taille, replace = TRUE)
sequence_str = paste(sequence, collapse = "")
header = sprintf(">Naif_%d_%d", taille, numero)
writeLines(c(header, sequence_str), fileout)
}
close(fileout)
}
longu = c(100, 200, 500, 1000, 1500, 2000)
for (elem in longu){
naif_fasta(elem)
}
prob_fasta = function(taille, prob){
nom = sprintf("Proba_%d.fasta", taille)
fileout = file(nom, open = "w")
nucleotides = c('A', 'T', 'C', 'G')
for (numero in 0:29) {
sequence = sample(nucleotides, size = taille, replace = TRUE, prob = prob)
sequence_str = paste(sequence, collapse = "")
header = sprintf(">Naif_%d_%d", taille, numero)
writeLines(c(header, sequence_str), fileout)
}
close(fileout)
}
prob_fasta = function(taille, prob){
nom = sprintf("Proba_%d.fasta", taille)
fileout = file(nom, open = "w")
nucleotides = c('A', 'T', 'C', 'G')
for (numero in 0:29) {
sequence = sample(nucleotides, size = taille, replace = TRUE, prob = prob)
sequence_str = paste(sequence, collapse = "")
header = sprintf(">Naif_%d_%d", taille, numero)
writeLines(c(header, sequence_str), fileout)
}
close(fileout)
}
for (elem in longu){
prob_fasta(elem)
}
for (elem in longu){
prob_fasta(elem, prob)
}
