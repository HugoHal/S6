#Exo 4
naif_fasta = function(taille){
nom = cat("Naif_",taille,".fasta")
fileout = file(nom, open = "w")
nucleotides = c('A', 'T', 'C', 'G')
for (numero in range(0,29)){
sequence = sample(nucleotides, size = 10, replace= TRUE)
sequence_str = paste(sequence, collapse = "")
writeLines(paste("> Naif_", taille, "_", numero, "\n", sequence_str, sep = ""), fileout)
}
}
naif_fasta(50)
