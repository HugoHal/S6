prob_fasta = function(taille, prob){
nom = sprintf("Proba_%d.fasta", taille)
fileout = file(nom, open = "w")
nucleotides = c('A', 'T', 'C', 'G')
for (numero in 0:29) {
sequence = sample(nucleotides, size = taille, replace = TRUE, prob = prob)
sequence_str = paste(sequence, collapse = "")
header = sprintf(">Naif_%d_%d", taille, numero)
writeLines(c(header, sequence_str), fileout)
}
close(fileout)
}
for (elem in longu){
prob_fasta(elem, prob)
}
prob
