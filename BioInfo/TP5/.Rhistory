#Exercice 14
systema = function(quanti, quali, datagram){
for (elem in quanti) {
for (elem2 in quali) {
# Filtrer les lignes contenant des NA ou NaN dans les colonnes concernées
valid_idx = !is.na(datagram[[elem]]) & !is.nan(datagram[[elem]]) &
!is.na(datagram[[elem2]]) & !is.nan(datagram[[elem2]])
# Appliquer le filtre aux données
valid_data = datagram[valid_idx, c(elem, elem2)]
# Créer la table de contingence avec les données valides
try_table <- table(valid_data[[1]], valid_data[[2]])
r =  Vcram(try_table)
cat( names(datagram)[elem], "   ", names(datagram)[elem2], "         Vcram:", r, "\n")
}
}
}
systema(quanti, quali, mais)
#Exercice 14
systema = function(quanti, quali, datagram){
for (elem in quanti) {
for (elem2 in quali) {
valid_idx = !is.na(datagram[[elem]]) & !is.nan(datagram[[elem]]) &
!is.na(datagram[[elem2]]) & !is.nan(datagram[[elem2]])
valid_data = datagram[valid_idx, c(elem, elem2)]
try_table <- table(valid_data[[1]], valid_data[[2]])
if (length(try_table) > 0) {
r = Vcram(try_table)
cat(names(datagram)[elem], "   ", names(datagram)[elem2], "         Vcram:", r, "\n")
} else {
cat(names(datagram)[elem], "   ", names(datagram)[elem2], "         Table vide après filtrage.\n")
}
}
}
}
