rapport = function(valeur, groupe){
valid_idx = !is.na(valeur) & !is.na(groupe)
if (sum(valid_idx) == 0) {
return(NA)
}
valeur_filtre = valeur[valid_idx]
groupe_filtre = groupe[valid_idx]
return (SCE(valeur_filtre, groupe_filtre) / SCT(valeur_filtre))
}
